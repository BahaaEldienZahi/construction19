<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="nt__resignation_view_employee_form" model="ir.ui.view">
            <field name="name">resignation.hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='category_ids']" position="after">
                    <group>
                        <field name="is_resigned" readonly="1"/>
                    </group>
                </xpath>

            </field>
        </record>
    </data>
</odoo>
