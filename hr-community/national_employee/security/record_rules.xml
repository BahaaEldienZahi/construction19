<odoo>

    <record id="hr_employee_base_user_rule" model="ir.rule">
        <field name="name">Employee: Base User: Read Own</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


    <record id="hr_public_employee_base_user_rule" model="ir.rule">
        <field name="name">public Employee: Base User: Read Own</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <!--###########################################################################################-->


    <record id="hr_employee_officer_rule" model="ir.rule">
        <field name="name">Employee: Officer: Read All</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="domain_force">['|',('user_id', '=', user.id),('parent_id.user_id','=',user.id)]
        </field> <!-- Allows access to all records -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


    <record id="hr_employee_public_officer_rule" model="ir.rule">
        <field name="name">Employee: Officer: Read All</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]"/>
        <field name="domain_force">['|',('user_id', '=', user.id),('parent_id.user_id','=',user.id)]
        </field> <!-- Allows access to all records -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>


    <!--    ####################################################################################################-->

    <record id="hr_employee_admin_rule" model="ir.rule">
        <field name="name">Employee: Admin: Read-Create All</field>
        <field name="model_id" ref="hr.model_hr_employee"/>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>


    <record id="hr_employee_public_admin_rule" model="ir.rule">
        <field name="name">Employee: Admin: Read-Create All</field>
        <field name="model_id" ref="hr.model_hr_employee_public"/>
        <field name="groups" eval="[(4, ref('base.group_erp_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="False"/>
    </record>


</odoo>