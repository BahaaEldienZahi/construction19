<odoo>
    <data noupdate="0">

        <record id="hr_salary_rule_comp_money" model="hr.salary.rule">
            <field name="code">COMP_MONEY</field>
            <field name="name">Compensation Money</field>
            <field name="category_id" ref="hr_payroll_community.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = (inputs.COMP_MONEY and inputs.COMP_MONEY.amount > 0) or False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.COMP_MONEY.amount</field>
            <field name="sequence" eval="31"/>
        </record>

        <record id="hr_salary_rule_comp_leave_money" model="hr.salary.rule">
            <field name="code">COMP_LEAVE_MONEY</field>
            <field name="name">Compensation Leave Money</field>
            <field name="category_id" ref="hr_payroll_community.ALW"/>
            <field name="condition_select">python</field>
            <field name="condition_python">result = (inputs.COMP_LEAVE_MONEY and inputs.COMP_LEAVE_MONEY.amount > 0) or False</field>
            <field name="amount_select">code</field>
            <field name="amount_python_compute">result = inputs.COMP_LEAVE_MONEY.amount</field>
            <field name="sequence" eval="32"/>
        </record>
    </data>
</odoo>