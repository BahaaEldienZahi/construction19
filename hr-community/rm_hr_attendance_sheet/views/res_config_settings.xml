<odoo>
    <record id="add_attendance_policy" model="ir.ui.view">
        <field name="name">add_attendance_policy</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//block[@name='employee_rights_setting_container']" position="after">
                <block title="Employee Attendance Policy" name="employee_attendance_policy">

                    <setting help="Choose attendance policy for all employees">
                        <field name="attendance_policy_id"/>
                    </setting>

                </block>
            </xpath>

        </field>
    </record>
</odoo>