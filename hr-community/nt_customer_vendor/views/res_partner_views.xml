<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.sales.person.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="foreign_name" placeholder="Foreign Name"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="contact_type" required="1"/>
<!--                <field name="vendor_type" widget="radio"-->
<!--                       invisible="contact_type != 'vendor'"-->
<!--                       required="contact_type == 'vendor'"/>-->
<!--                       attrs="{'invisible':[('contact_type','!=','vendor')],'required':[('contact_type','=','vendor')]}"/>-->
            </xpath>
<!--            <xpath expr="//page[@name='sales_purchases']//field[@name='user_id']" position="attributes">-->
<!--                <field name="contact_type" invisible="1"/>-->
<!--                <attribute name="required">contact_type == 'customer'</attribute>-->
<!--                <attribute name="attrs">{'required': [('contact_type', '=', 'customer')]}</attribute>-->
<!--            </xpath>-->
            <xpath expr="//page[@name='sales_purchases']//field[@name='property_payment_term_id']" position="after">
                <field name="use_excel" invisible="contact_type == 'customer'"/>
<!--                attrs="{'invisible': [('contact_type', '=', 'customer')]}"/>-->
            </xpath>
        </field>
    </record>


