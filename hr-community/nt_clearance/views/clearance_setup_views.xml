<odoo>
    <!-- Form -->
    <record id="view_clearance_setup_tree" model="ir.ui.view">
        <field name="name">clearance.setup.tree</field>
        <field name="model">clearance.setup</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="department_id"/>
                <field name="owner_ids" widget="many2many_tags"/>
                <field name="sequence"/>
            </tree>
        </field>
    </record>


    <!-- Action -->
    <record id="action_clearance_setup" model="ir.actions.act_window">
        <field name="name">Setup</field>
        <field name="res_model">clearance.setup</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Menu -->


</odoo>
