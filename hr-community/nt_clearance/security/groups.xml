<odoo>
    <record id="group_clearance_user" model="res.groups">
        <field name="name">Clearance User</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
    </record>

    <record id="group_clearance_manager" model="res.groups">
        <field name="name">Clearance Manager</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(5,)]"/>
    </record>

    <record id="group_clearance_admin" model="res.groups">
        <field name="name">Clearance Admin</field>
        <field name="category_id" ref="base.module_category_human_resources"/>
        <field name="implied_ids" eval="[(5,)]"/>
    </record>

    <record id="rule_clearance_line_manager_own" model="ir.rule">
        <field name="name">Clearance Lines: Manager sees own lines</field>
        <field name="model_id" ref="model_clearance_request_line"/>
        <field name="groups" eval="[(4, ref('nt_clearance.group_clearance_manager'))]"/>
        <field name="domain_force">[('owner_ids', 'in', [user.id])]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>
    <record id="rule_clearance_line_admin_all" model="ir.rule">
        <field name="name">Clearance Lines: Admin sees all lines</field>
        <field name="model_id" ref="model_clearance_request_line"/>
        <field name="groups" eval="[(4, ref('nt_clearance.group_clearance_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>
