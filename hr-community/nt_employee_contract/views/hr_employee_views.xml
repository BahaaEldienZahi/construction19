        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="70"/>
            <field name="inherit_id" ref="hr_payroll_community.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!--                <xpath expr="//div[hasclass('settings')]//div[@data-key='hr']" position="inside">-->
                <xpath expr="//form//app[@name='hr_payroll_community']" position="inside">
                    <!--                    <div class="app_settings_block" data-string="Employees" string="Employees"-->
                    <!--                         groups="hr.group_hr_manager">-->
                    <block title="Archiving" id="hr_payroll_archiving">
                        <setting id="payslip_archiving_2" string="Archiving">
<!--                            <h2>Archiving</h2>-->
                            <div class="row mt16 o_settings_container" name="archiving_setting_container">
                                <div class="col-12 col-lg-6 o_setting_box"
                                     title="Archive End Date">
                                    <div class="o_setting_left_pane">
                                        <field name="archive_end_date"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label for="archive_end_date"/>
                                        <div class="text-muted">
                                            cron job to archive outdated contract on that day
                                        </div>
                                    </div>
                                </div>
                                <div class="col-12 col-lg-6 o_setting_box"
                                     title="Day Of Previous Month">
                                    <div class="o_setting_left_pane">
                                        <field name="day_of_previous_month"/>
                                    </div>
                                    <div class="o_setting_right_pane">
                                        <label for="day_of_previous_month"/>
                                        <div class="text-muted">
                                            The day of previous month
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--                    </div>-->
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>


