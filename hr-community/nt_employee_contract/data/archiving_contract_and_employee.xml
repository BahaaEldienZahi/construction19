<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="archive_contract_employee_cron" forcecreate='True' model="ir.cron">
            <field name="name">Archive Contract and Employee</field>
            <field eval="True" name="active"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="hr_contract.model_hr_contract"/>
            <field name="state">code</field>
            <field name="code">model.archive_contract_and_employee()</field>
        </record>

        <record id="probation_period_notification_cron" model="ir.cron">
            <field name="name">Probation period send notification</field>
            <field eval="True" name="active"/>
<!--            <field name="user_id" ref="base.user_root"/>-->
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="nt_employee_contract.model_hr_employee"/>
            <field name="state">code</field>
<!--            <field name="doall">True</field>-->
            <field name="code">model.probation_period_end_date_notification()</field>
        </record>

    </data>
</odoo>