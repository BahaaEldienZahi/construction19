<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Form View to Modify it -->
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">view.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page[@name='hr_settings']//field[@name='user_id']" position="after">
                 <field name="referred_partner_id" invisible="1"/>
                <field name="ref_employee_id" />
                <field name="referral_by_email"/>
                <field name="categ_ids" widget="many2many_tags"/>
            </xpath>

        </field>
    </record>
</odoo>