<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--     Inherit Form View to Modify it -->
    <record id="hr_applicant_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.view.form.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="mode">primary</field>
        <field name="priority">20</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">

            <!--            <xpath expr="//field[@name='name']" position="">-->
            <!--                &lt;!&ndash; Add your fields or attributes here &ndash;&gt;-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <!--            <xpath expr="//field[@name='categ_ids']" position="attributes">-->
            <!--                 <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>-->
            <!--            </xpath>-->
            <xpath expr="//field[@name='type_id']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='team_id']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>

            <xpath expr="//field[@name='medium_id']" position="after">
                <field name="referred_partner_id" invisible="1"/>
                <field name="hide_button" invisible="1"/>
            </xpath>
            <xpath expr="//button[@name='open_stages_applicant']" position="attributes">
                <attribute name="invisible">hide_button</attribute>
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
                <!--                 <attribute name="attrs">{'invisible': [('hide_button', '=', True)]}</attribute>-->
            </xpath>
            <xpath expr="//button[@name='archive_applicant']" position="attributes">
                <attribute name="invisible">hide_button</attribute>
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
                <!--                 <attribute name="attrs">{'invisible': [('hide_button', '=', True)]}</attribute>-->
            </xpath>
            <xpath expr="//button[@name='create_job_offer_from_applicant']" position="attributes">
                <attribute name="invisible">hide_button or hide_create_action</attribute>
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
                <!--                 <attribute name="attrs">{'invisible': [('hide_button', '=', True)]}</attribute>-->
            </xpath>
            <xpath expr="//button[@name='send_attachment_reminder_manually']" position="attributes">
                <attribute name="invisible">hide_button</attribute>
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
                <!--                 <attribute name="attrs">{'invisible': [('hide_button', '=', True)]}</attribute>-->
            </xpath>
            <xpath expr="//button[@name='action_show_job_offers']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='job_offer_ids']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='department_id']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <!--            <xpath expr="//field[@name='job_id']" position="attributes">-->
            <!--                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>-->
            <!--            </xpath>-->
            <xpath expr="//sheet/group[1]/group[4]" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='email_cc']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='interviewer_ids']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='user_id']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='source_id']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='availability']" position="attributes">
                <attribute name="required">0</attribute>
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='senior_id']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='assigned_team_leader_id']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//field[@name='cv_link']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
            <xpath expr="//page[@name='application_summary']" position="attributes">
                <attribute name="groups">referral_custom.group_referral_hr_Manager</attribute>
            </xpath>
        </field>
    </record>

    <record id="action_server_application" model="ir.actions.act_window">
        <field name="name">Applications</field>
        <field name="res_model">hr.applicant</field>
        <field name="view_mode">kanban,tree,form,pivot,graph,calendar,activity</field>
        <field name="view_id" ref="referral_custom.hr_applicant_view_form_inherit"/>
        <field name="context">{'hide_referal': True}</field>

    </record>


    <record id="hr_applicant_view_kanban_inherit" model="ir.ui.view">
        <field name="name">hr.applicant.view.kanban.inherit</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="records_draggable">0</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_kanban_record_top')]" position="after">
                <ul>
                    <li>
                        <field name="email_from"/>
                    </li>
                </ul>
            </xpath>
        </field>
    </record>

