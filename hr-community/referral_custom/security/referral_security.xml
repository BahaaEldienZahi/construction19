<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="referral_category" model="ir.module.category">
            <field name="name">Referral Groups</field>
            <field name="sequence" eval="1"/>
        </record>
        <record id="group_referral_hr_user" model="res.groups">
            <field name="name">Referral user </field>
            <field name="category_id" ref="referral_category"/>

        </record>
         <record id="group_referral_hr_Manager" model="res.groups">
            <field name="name">Referral Manager </field>
            <field name="category_id" ref="referral_category"/>
        </record>

        <record id="record_hr_job_user_rule" model="ir.rule">
            <field name="name">Referral Job User Rule</field>
            <field ref="model_hr_job" name="model_id"/>
            <field name="domain_force">[('no_of_recruitment','>',0 )]</field>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <!-- You can attach this rule to a specific group, Or make it Global -->
            <field name="groups" eval="[(4, ref('referral_custom.group_referral_hr_user'))]"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="record_hr_job_manager_rule" model="ir.rule">
            <field name="name">Referral Job Managers </field>
            <field name="model_id" ref="model_hr_job"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('referral_custom.group_referral_hr_Manager'))]"/>
        </record>

<!--        <record id="group_referral_hr_application_user" model="res.groups">-->
<!--            <field name="name">Referral user Application</field>-->
<!--            <field name="category_id" ref="referral_category"/>-->
<!--            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>-->
<!--        </record>-->
<!--         <record id="group_referral_hr_application_Manager" model="res.groups">-->
<!--            <field name="name">Referral Manager Application</field>-->
<!--            <field name="category_id" ref="referral_category"/>-->
<!--            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>-->
<!--        </record>-->
        <record id="record_hr_applicant_user_rule" model="ir.rule">
            <field name="name">Referral Applicant User Rule</field>
            <field ref="model_hr_applicant" name="model_id"/>
             <field name="domain_force">[('create_uid','=', user.id)]</field>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <!-- You can attach this rule to a specific group, Or make it Global -->
            <field name="groups" eval="[(4, ref('referral_custom.group_referral_hr_user'))]"/>
            <!--<field name="global" eval="1"/> -->
        </record>

        <record id="record_hr_applicant_manager_rule" model="ir.rule">
            <field name="name">Referral Job Managers </field>
            <field name="model_id" ref="model_hr_applicant"/>
            <field name="domain_force">[(1,'=',1)]</field>
            <field name="groups" eval="[(4, ref('referral_custom.group_referral_hr_Manager'))]"/>
        </record>


    </data>
</odoo>