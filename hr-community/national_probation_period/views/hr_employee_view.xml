<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="nt_view_employee_form" model="ir.ui.view">
            <field name="name">hr.employee.form</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">

                <xpath expr="//field[@name='category_ids']" position="after">
                    <group>
                        <field name="in_probation_period" readonly="1"/>
                    </group>
                </xpath>

            </field>
        </record>

        <record id="nt_hr_kanban_view_employees" model="ir.ui.view">
            <field name="name">hr.employee.view.kanban</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.hr_kanban_view_employees"/>
            <field name="arch" type="xml">

                <xpath expr="//div[hasclass('oe_kanban_content')]" position="inside">
                    <field name="in_probation_period" invisible="1"/>
                    <span class="fa fa-plane text-info" invisible="not in_probation_period">
                        Probation Days:
                        <field name="remain_probation_period" string="Days" invisible="not in_probation_period"/>
                    </span>
                </xpath>

            </field>
        </record>

    </data>
</odoo>