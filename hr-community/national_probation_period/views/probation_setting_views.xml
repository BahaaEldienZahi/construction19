<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="probation_conf_setting_form" model="ir.ui.view">
        <field name="name">Settings</field>
        <field name="model">probation.config.settings</field>
        <field name="arch" type="xml">
            <form string="Settings" class="oe_form_configuration" js_class="base_settings">
                <app data-string="Probation" string="Probation" name="national_probation_period"
                     groups="national_probation_period.group_probation_period_admin">
                    <block title="Probation" name="probation_setting_container">
                        <div class="col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="num_day_before"/>
                                <div class="text-muted">
                                    ( Notify TL before ... days of probation end date )
                                </div>
                                <div>
                                    <field name="num_day_before"/>
                                </div>
                            </div>

                        </div>
                    </block>
                </app>


            </form>


        </field>
    </record>

    <record id="probation_config_settings_action" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">probation.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module' : 'national_probation_period', 'bin_size': False}</field>
    </record>

</odoo>