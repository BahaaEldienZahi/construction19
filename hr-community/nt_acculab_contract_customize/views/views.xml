<odoo>
    <data>

        <record model="ir.ui.view" id="view_contract_allowance_form">
            <field name="name">Allowance</field>
            <field name="model">contract.allowance</field>
            <field name="arch" type="xml">
                <form string="Allowance">
                    <sheet>
                        <group col="4">
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record model="ir.ui.view" id="view_contract_allowance_tree_allowance">
            <field name="name">Allowance</field>
            <field name="model">contract.allowance</field>
            <field name="arch" type="xml">
                <tree string="Allowance Tree" edit="true" editable="bottom"  create="true">
                    <field name="name"/>
                </tree>
            </field>
        </record>

        <record model="ir.ui.view" id="view_contract_deduction_form">
            <field name="name">Deduction</field>
            <field name="model">contract.deduction</field>
            <field name="arch" type="xml">
                <form string="Deduction">
                    <sheet>
                        <group col="4">
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_contract_deduction_tree">
            <field name="name">Deduction</field>
            <field name="model">contract.deduction</field>
            <field name="arch" type="xml">
                <tree string="Deduction" editable="bottom" edit="true" create="true">
                    <field name="name"/>
                </tree>
            </field>
        </record>


        <record id="action_contract_allowance" model="ir.actions.act_window">
            <field name="name">Allowances</field>
            <field name="res_model">contract.allowance</field>
            <field name="view_mode">tree</field>
        </record>
        <record id="action_contract_deduction" model="ir.actions.act_window">
            <field name="name">Deductions</field>
            <field name="res_model">contract.deduction</field>
            <field name="view_mode">tree,form</field>
        </record>


        <menuitem
                id="menu_contract_allowance"
                name="Allowances"
                parent="hr.menu_human_resources_configuration"
                action="action_contract_allowance"
                sequence="3"/>
        <menuitem
                id="menu_contract_deduction"
                name="Deductions"
                parent="hr.menu_human_resources_configuration"
                action="action_contract_deduction"
                sequence="4"/>
    </data>
</odoo>