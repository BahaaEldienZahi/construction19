            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="nt_penalty_and_reward.model_employee_penalty_reward" />
            <field name="binding_model_id" ref="nt_penalty_and_reward.model_employee_penalty_reward" />
            <field name="state">code</field>
            <field name="code">action = records.refuse_all()</field>
