<odoo>
    <data>
        <!-- ============== [tree view ] ============= -->
        <record id="employee_penalty_tree_view" model="ir.ui.view">
            <field name="name">employee.penalty.tree.view</field>
            <field name="model">employee.penalty</field>

            <field name="arch" type="xml">
                <tree string="Penalties" sample="1" edit="1">
                    <field name='name' string="Name"/>
                    <field name='description' string="Description"/>
                    <field name="category_id"/>
                    <field name='struct_id'/>
                    <field name='code' optional="hide"/>
                </tree>
            </field>
        </record>

        <!-- ============== [form view ] ============= -->
        <record id="employee_penalty_form_view" model="ir.ui.view">
            <field name="name">employee.penalty.form.view</field>
            <field name="model">employee.penalty</field>
            <field name="arch" type="xml">
                <form string="employee penalty">
                    <sheet>
                        <group>
                            <group string="Penalties">
                                <field name="name" string="Name" required="1"/>
                                <field name='description' string="Description"/>
                            </group>
                            <group string="Rule Info">
                                <field name="category_id" required="1"/>
                                <field name='struct_id' required="1"/>
                                <field name='code' required="1"/>
                                <field name='is_resignation'/>
                            </group>
                        </group>
                    </sheet>
                </form>

            </field>
        </record>


        <record id="penalty_search" model="ir.ui.view">
            <field name="name">penalty search</field>
            <field name="model">employee.penalty</field>
            <field name="arch" type="xml">
                <search>
                    <field name='name'/>
                    <filter string="Archived" name="active" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- ============== [employee penalty reward action] ============= -->
        <record model="ir.actions.act_window" id="employee_penalty_action">
            <field name="name">Penalties</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.penalty</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    create employee penalty!
                </p>
            </field>
        </record>

    </data>
</odoo>