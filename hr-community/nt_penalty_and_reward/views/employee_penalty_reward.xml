<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ============== [tree view ] ============= -->
        <record id="employee_penalty_reword_tree_view" model="ir.ui.view">
            <field name="name">employee.penalty.reward.tree.view</field>
            <field name="model">employee.penalty.reward</field>
            <field name="arch" type="xml">
                <tree sample="1" string="employee penalty and reward">
                    <field name="employee_id"/>
                    <field name="start_date"/>
                    <field name="end_date" string="To"/>
                    <field decoration-info="state == 'confirm'" decoration-success="state == 'approve'" name="state" string="Status" widget="badge"/>
                    <field name="total_penalty_money"/>
                    <field name="total_penalty_days"/>
                    <field name="total_reward_money"/>
                    <field name="total_reward_days"/>
                </tree></field>
        </record>
        <!-- ============== [form view ] ============= -->
        <record id="employee_penalty_reword_form_view" model="ir.ui.view">
            <field name="name">employee.penalty.reward.form.view</field>
            <field name="model">employee.penalty.reward</field>
            <field name="arch" type="xml">
                <form string="employee penalty reward">
                    <header>
                        <button class="btn-primary" invisible="state in ['confirm', 'approve', 'rej']" name="action_do_confirm" string="confirm" type="object"/>
                        <button class="btn-primary" groups="nt_penalty_and_reward.group_penalty_reward_admin" invisible="state in ['draft', 'approve', 'rej']" name="action_do_approve" string="approve" type="object"/>
                        <button class="btn-primary" groups="nt_penalty_and_reward.group_penalty_reward_admin" invisible="state == 'draft' or state == 'rej'" name="reason_wizard" string="Reject" type="object"/>
                        <button class="btn-primary" invisible="state not in ['rej']" name="action_do_draft" string="Set to draft" type="object"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group col="1">
                                <group>
                                    <field name="employee_id"/>
                                </group>
                                <group>
                                    <group>
                                        <label for="start_date" string="From:"/>
                                        <field name="start_date" nolabel="1" widget="date"/>
                                    </group>
                                    <group>
                                        <label for="end_date" string="To:"/>
                                        <field name="end_date" nolabel="1" widget="date"/>
                                    </group>
                                </group>                            </group>
                            <group col="2">
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th scope="col"/>
                                            <th scope="col">
                                                Penalties
                                            </th>
                                            <th scope="col">
                                                Reward
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <th scope="row">
                                                Money
                                            </th>
                                            <td>
                                                <field force_save="1" name="total_penalty_money" nolabel="1" readonly="1"/>
                                            </td>
                                            <td>
                                                <field force_save="1" name="total_reward_money" nolabel="1" readonly="1"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th scope="row">
                                                Days
                                            </th>
                                            <td>
                                                <field name="total_penalty_days" nolabel="1" readonly="1"/>
                                            </td>
                                            <td>
                                                <field name="total_reward_days" nolabel="1" readonly="1"/>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th scope="row">
                                                Hours
                                            </th>
                                            <td>
                                                <field name="total_penalty_hours" nolabel="1" readonly="1"/>
                                            </td>
                                            <td>
                                                <field name="total_reward_hours" nolabel="1" readonly="1"/>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </group>
                        </group>
                        <group>
                            <group invisible="state != 'rej'" string="Rejection Reason">
                                <field invisible="state != 'rej'" name="penalty_reward_refuse_reason" nolabel="1"/>
                            </group>
                            <group invisible="state == 'rej'"/>
                            <group col="2">
                                <div class="row">
                                    <div class="col-4 d-inline">
                                        Leave Balance
                                    </div>
                                    <div class="col-4 d-inline">
                                        <field name="remaining_leaves"/>
                                    </div>
                                </div>
                            </group>
                        </group>
                        <notebook>
                            <page name="penalties" string="Penalties">
                                <field name="employee_penalty_ids"><tree editable="bottom">
                                        <field force_save="1" name="penalty_id" required="1"/>
                                        <field name="payment_method"/>
                                        <field name="amount_day" readonly="payment_method != 'day'"/>
                                        <field name="amount_money" readonly="payment_method != 'money'"/>
                                        <field name="amount_hour" readonly="payment_method != 'hour'"/>
                                    </tree>
                                    <form/></field>
                            </page>
                            <page name="rewords" string="Rewards">
                                <field name="employee_reward_ids"><tree editable="bottom">
                                        <field force_save="0" name="reward_id" options="{'no_create':True, 'no_create_update': True, 'no_open': True}" required="1"/>
                                        <field name="payment_method"/>
                                        <field name="amount_day" readonly="payment_method != 'day'"/>
                                        <field name="amount_money" readonly="payment_method != 'money'"/>
                                        <field name="amount_hour" readonly="payment_method != 'hour'"/>
                                    </tree>
                                    <form/></field>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field groups="base.group_user" name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form></field>
        </record>
        <record id="employee_penalty_reward_search" model="ir.ui.view">
            <field name="name">employee penalty reward search</field>
            <field name="model">employee.penalty.reward</field>
            <field name="arch" type="xml">
                <search>
                    <field name="employee_id"/>
                    <field name="state"/>
                    <filter domain="[('active', '=', False)]" name="active" string="Archived"/>
                    <group expand="0" string="Group By">
                        <filter context="{'group_by':'employee_id'}" domain="[]" name="employee_id" string="Employee"/>
                        <filter context="{'group_by':'state'}" domain="[]" name="state" string="State"/>
                    </group>
                </search></field>
        </record>
        <!-- ============== [employee penalty reward action] ============= -->
        <record id="employee_penalty_reward_action" model="ir.actions.act_window">
            <field name="name">Penalties  Rewards</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.penalty.reward</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create penalty and reward !
                </p></field>
        </record>
    </data>
</odoo>
