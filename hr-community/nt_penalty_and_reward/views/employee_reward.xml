<odoo>
    <data>
        <!-- ============== [tree view ] ============= -->
        <record id="employee_reword_tree_view" model="ir.ui.view">
            <field name="name">employee.reward.tree.view</field>
            <field name="model">employee.reward</field>

            <field name="arch" type="xml">
                <tree string="Rewards" sample="1" edit="1">
                    <field name='name' string="Name"/>
                    <field name='description' string="Description"/>
                    <field name="category_id"/>
                    <field name='struct_id'/>
                    <field name='code' optional="hide"/>
                </tree>
            </field>
        </record>

        <record id="employee_reword_form_view" model="ir.ui.view">
            <field name="name">employee.reward.form.view</field>
            <field name="model">employee.reward</field>
            <field name="arch" type="xml">
                <form string="employee reward">
                    <sheet>
                        <group>
                            <group string="Reward Info">
                                <field name="name" string="Name" required="1"/>
                                <field name='description' string="Description"/>
                                <field name='is_vacations_instead'/>
                            </group>
                            <group string="Rule Info">
                                <field name="category_id" required="1"/>
                                <field name='struct_id' required="1"/>
                                <field name='code' required="1"/>
                                <field name='is_time_off'/>
                            </group>
                        </group>
                    </sheet>
                </form>

            </field>
        </record>

        <record id="reward_search" model="ir.ui.view">
            <field name="name">reward search</field>
            <field name="model">employee.reward</field>
            <field name="arch" type="xml">
                <search>
                    <field name='name'/>
                    <filter string="Archived" name="active" domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

        <!-- ============== [employee penalty reward action] ============= -->
        <record model="ir.actions.act_window" id="employee_reward_action">
            <field name="name">Rewards</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">employee.reward</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    create employee reward !
                </p>
            </field>
        </record>

        <record id="settings_action" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{'module': 'nt_penalty_and_reward'}</field>
        </record>

    </data>
</odoo>