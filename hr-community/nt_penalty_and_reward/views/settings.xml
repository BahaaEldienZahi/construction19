<odoo>
    <data>

        <record id="res_config_settings_view_form_late_time_by_month" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.late_time_by_month</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="nt_penalty_and_reward" string="National Penalty And Reward" name="nt_penalty_and_reward">
                        <h2>Late Rules</h2>
                        <div class="row mt16 o_settings_container" name="late_time_by_month">
                            <div class="col-12 col-lg-6 o_setting_box">
                                <label for="late_time_by_month"/>
                                <field name="late_time_by_month"/>
                                <div class="text-muted">
                                    Minutes
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <label for="penalty_days"/>
                                <field name="penalty_days"/>
                                <div class="text-muted">
                                    Day
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <label for="late_time_penalty_id"/>
                                <field name="late_time_penalty_id"/>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box">
                                <label for="late_time_reward_id"/>
                                <field name="late_time_reward_id"/>
                            </div>
                        </div>
                    </app>
                </xpath>
            </field>
        </record>
    </data>
</odoo>