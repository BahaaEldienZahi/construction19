<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="group_interviewer" model="res.groups">
            <field name="name"> Interviewer </field>
            <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
            <field name="implied_ids" eval="[(4,ref('base.group_user'))]" />
        </record>
        <record id="group_team_leader" model="res.groups">
            <field name="name">Team Leader</field>
            <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
            <field name="implied_ids" eval="[(4, ref('nt_recruitment_update.group_interviewer'))]"/>
        </record>
        <!--        Hr Applicant rule-->
        <record id="recruitment_update_job_user_rule" model="ir.rule">
            <field name="name">hr.job: user rule</field>
            <field name="model_id" ref="hr_recruitment.model_hr_job"/>
            <field name="groups" eval="[(4, ref('nt_recruitment_update.group_interviewer'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
        </record>

         <record id="recruitment_update_job_interviewer_rule" model="ir.rule">
            <field name="name">hr.job: interviewer rule</field>
            <field name="model_id" ref="hr_recruitment.model_hr_job"/>
            <field name="groups" eval="[(4, ref('nt_recruitment_update.group_interviewer'))]"/>
            <field name="domain_force">[('interviewer_ids', 'in', [user.id])]</field>
        </record>
        <record id="recruitment_update_job_manager_rule" model="ir.rule">
            <field name="name">hr.job: manager rule</field>
            <field name="model_id" ref="hr_recruitment.model_hr_job"/>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        ################################################

        <record id="applicant_update_folder_user_rule" model="ir.rule">
            <field name="name">hr.applicant: user rule</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="groups" eval="[(4, ref('nt_recruitment_update.group_interviewer'))]"/>
            <field name="domain_force">[('team_id.senior_id', '=',user.id)]</field>
        </record>




        <record id="applicant_update_job_manager_rule" model="ir.rule">
            <field name="name">hr.job: manager rule</field>
            <field name="model_id" ref="hr_recruitment.model_hr_applicant"/>
            <field name="groups" eval="[(4, ref('hr_recruitment.group_hr_recruitment_manager'))]"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>
        <record id="boarding_record_rule" model="ir.rule">
            <field name="name">On Boarding Rule</field>
            <field ref="nt_recruitment_update.model_boarding_boarding" name="model_id"/>
             <field name="domain_force">[('responsible_id.user_id', '=', user.id)]</field>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>



</odoo>
