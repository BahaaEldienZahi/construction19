<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="group_ceo_approve_job_offer" model="res.groups">
            <field name="name">Team leader approve</field>
            <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
            <field name="implied_ids" eval="[(4, ref('nt_recruitment_update.group_team_leader'))]"/>
        </record>

        <record id="on_boarding_group" model="res.groups">
            <field name="name">on boarding</field>
            <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        </record>




        <record id="expected_and_proposed_salary" model="res.groups">
            <field name="name"> Expected and proposed Salary</field>
            <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
             <field name="implied_ids" eval="[(4, ref('nt_recruitment_update.group_ceo_approve_job_offer')),(4, ref('nt_recruitment_update.group_interviewer'))]"/>
        </record>

        <record id="group_create_job_offer" model="res.groups">
            <field name="name"> create job offer </field>
            <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
             <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
        <record id="group_hr_recruitment_ceo" model="res.groups">
            <field name="name"> CEO </field>
            <field name="category_id" ref="base.module_category_human_resources_recruitment"/>
        </record>

    </data>
</odoo>