<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <record id="email_template_offer_link" model="mail.template">
            <field name="name">Job Offer Email</field>
            <field name="subject">National Technology - Job Offer - {{object.applicant_id.name}}</field>
            <field name="email_from">{{user.email_formatted or object.company_id.email or object.user_id.email}}</field>
            <field name="email_to">{{object.applicant_id.email_from}}</field>
            <field name="model_id" ref="model_hr_job_offer"/>
            <field name="body_html" type="html">
                <p style="padding: 0px 10px;">
                    <div style="font-size: 13px; margin: 0px; padding: 0px;">
                        Dear
                        <span>
                            <t t-out="object.applicant_id.name or ''"/>
                        </span>,
                        <br/>
                        <span>It’s our pleasure to be part of our family. We are delighted to offer you the position of
                            <t t-out="object.applicant_id.job_id.name or ''"/>.
                        </span>
                        <br/>
                        <span>As discussed, please find attached your detailed offer letter through this link:</span>
                        <a t-attf-href="{{ user.company_id.website }}/recruitment/offer/{{object.token}}" target="new"
                           class="btn btn-primary btn-sm">
                            Link
                        </a>
                        <br/>
                        <span>If you choose to accept this offer, please mark Accept &amp; Choose your starting date with
                            us.
                        </span>
                        <br/>
                        <span>In the meantime, please don’t hesitate to reach out to us, either through email or by
                            calling directly if you have any questions or concerns.
                        </span>
                        <br/>
                        <span>Best Regards</span>
                    </div>
                </p>
            </field>
        </record>
        <record id="email_offer_acceptance" model="mail.template">
            <field name="name">Job Offer Acceptance</field>
            <field name="subject">Acceptance Job Offer for {{object.applicant_id.name}}</field>
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="email_to">{{object.applicant_id.email_from}}</field>
            <field name="model_id" ref="model_hr_job_offer"/>
            <field name="body_html" type="html">
                <p valign="top" style="padding: 0px 10px;">
                    <div style="font-size: 13px; margin: 0px; padding: 0px;">
                        Dear
                        <span>
                            <t t-out="object.applicant_id.name or ''"></t>
                        </span>
                        <br/>
                        this acceptance job offer
                    </div>
                </p>

            </field>
        </record>
        <record id="email_template_survey_link" model="mail.template">
            <field name="name">survey email joining Date</field>
            <field name="subject">We Value Your Feedback: Quick Survey Inside! {{object.applicant_id.name}}</field>
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="email_to">{{object.applicant_id.email_from}}</field>
            <field name="model_id" ref="model_hr_job_offer"/>
            <field name="body_html" type="html">
                <p valign="top" style="padding: 0px 10px;">
                    <div style="font-size: 13px; margin: 0px; padding: 0px;">
                        <span><t t-out="object.applicant_id.name or ''"></t>, could you spare a moment
                            to fill out our short survey?
                            <br/>
                            Your insights are invaluable to us!
                            <span>
                                <a t-attf-href="/survey/start/{{object.survey_access_token}}" target="new"
                                   class="btn btn-primary btn-sm">
                                    job offer
                                </a>
                            </span>
                            <br/>
                            . Thanks! 🌟


                        </span>

                    </div>
                </p>

            </field>
        </record>
    </data>
</odoo>