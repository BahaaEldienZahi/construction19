<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">

        <!--        ############### recruitment stages mail template ############## -->


        <record id="initial_screening_template" model="mail.template">
            <field name="name">Applicant: Initial Screening "Acknowledge"</field>
            <field name="model_id" ref="nt_recruitment_update.model_hr_applicant"/>
            <field name="subject">Your Job Application: {{object.job_id.name}}</field>
<!--            <field name="email_from">{{user.email_formatted or object.company_id.email or object.user_id.email}}</field>-->
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="email_to">{{object.email_from}}</field>
            <field name="body_html" type="html">
                <p>
                    <div style="font-size: 15px; margin: 0px; padding: 0px;">
                        Dear :
                        <span>
                            <t t-out="object.name or ''"/>
                        </span>
                        <br/>
                        <br/>
                        Thank you for applying to National Technology for Software.
                        <br/>
                        We are pleased that you are interested in joining us for the position of<t
                            t-out="object.job_id.name or ''"/>.
                        <br/>
                        <br/>
                        Will get back to you shortly.
                        <br/>
                        <br/>


                        Best Regards,
                        <br/>

                        HR Team
                        <br/>

                        National Technology for Software
                        <br/>

                    </div>
                </p>

            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
        </record>
        <record id="technically_shortlisted_template" model="mail.template">
            <field name="name">Applicant: Technically Shortlisted</field>
            <field name="model_id" ref="nt_recruitment_update.model_hr_applicant"/>
            <field name="subject">Your Job Application: {{object.job_id.name}}</field>
<!--            <field name="email_from">{{user.email_formatted or object.company_id.email or object.user_id.email}}</field>-->
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="email_to">{{object.email_from}}</field>
            <field name="body_html" type="html">
                <p>
                    <div style="font-size: 15px; margin: 0px; padding: 0px;">
                        Dear :
                        <span>
                            <t t-out="object.name or ''"/>

                        </span>
                        <br/>
                        <br/>
                        Congratulations!
                        <br/>


                        Your application has been short-listed, and one of our HR team will contact you to arrange an
                        interview.
                        <br/>
                        <br/>

                        See you soon,
                        <br/>
                        <br/>


                        Best Regards,
                        <br/>

                        HR Team
                        <br/>

                        National Technology for Software
                        <br/>

                    </div>
                </p>

            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>

        </record>
        <record id="1st_technical_interview_template" model="mail.template">
            <field name="name">Applicant: 1st Technical Interview</field>
            <field name="model_id" ref="nt_recruitment_update.model_hr_applicant"/>
            <field name="subject">Your Job Application: {{object.job_id.name}}</field>
<!--            <field name="email_from">{{user.email_formatted or object.company_id.email or object.user_id.email}}</field>-->
            <field name="email_from">{{object.company_id.email}}</field>
            <field name="email_to">{{object.email_from}}</field>
            <field name="body_html" type="html">
                <p>
                    <div style="font-size: 15px; margin: 0px; padding: 0px;">
                        Dear :
                        <span>
                            <t t-out="object.name or ''"/>

                        </span>
                        <br/>
                        <br/>
                        Congratulations!
                        <br/>


                        You have passed the HR interview , your technical interview will be on
                        <t t-out="format_datetime(object.interview_date, tz=object.user_id.tz, dt_format=&quot;yyyy-MM-dd HH:mm:ss'&quot;)"/>
                        as<t t-out="object.job_id.name or ''"/>.
                        <br/>
                        <br/>

                        See you soon,
                        <br/>
                        <br/>


                        Best Regards,
                        <br/>

                        HR Team
                        <br/>

                        National Technology for Software
                        <br/>

                    </div>
                </p>

            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>

        </record>

        <record id="2nd_technical_interview_template" model="mail.template">
            <field name="name">Applicant: 2nd Technical Interview</field>
            <field name="model_id" ref="nt_recruitment_update.model_hr_applicant"/>
            <field name="subject">Your Job Application: {{object.job_id.name}}</field>
<!--            <field name="email_from">{{user.email_formatted or object.company_id.email or object.user_id.email}}</field>-->
