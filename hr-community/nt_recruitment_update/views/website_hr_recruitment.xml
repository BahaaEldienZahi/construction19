<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="apply_form_inherited" inherit_id="website_hr_recruitment.apply">

            <xpath expr="//form[@id='hr_recruitment_form']/div/div[3]/div/label/span[1]" position="replace">
                <span class="s_website_form_label_content">Your Mobile Number</span>
            </xpath>

            <xpath expr="//textarea[@id='recruitment5']" position="replace">
                <textarea id="recruitment5"
                          class="form-control s_website_form_input"
                          placeholder="Tell us briefly about yourself"
                          name="description" rows="5"/>
            </xpath>

            <xpath expr="//a[@id='apply-btn']" position="replace">
                <a href="#" role="button" class="btn btn-primary btn-lg s_website_form_send" id="apply-btn">Submit</a>
            </xpath>

            <xpath expr="//hr[1]" position="replace"/>

            <xpath expr="//div[@t-field='job.job_details']" position="replace"/>

            <xpath expr="//form[@id='hr_recruitment_form']/div/div[3]" position="after">
                <div class="col-12 mb-0 py-2 s_website_form_field s_website_form_required"
                     data-type="char" data-name="Field">
                    <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-4 col-sm-auto s_website_form_label" style="width: 200px" for="recruitment9">
                            <span class="s_website_form_label_content">Your Expected Salary</span>
                            <span class="s_website_form_mark">*</span>
                        </label>
                        <div class="col-sm">
                            <input id="recruitment9" type="text"
                                   class="form-control s_website_form_input"
                                   name="salary_expected" required=""
                                   data-fill-with="text"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 mb-0 py-2 s_website_form_field s_website_form_required"
                     data-type="char" data-name="Field">
                    <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-4 col-sm-auto s_website_form_label" style="width: 200px" for="recruitment10">
                            <span class="s_website_form_label_content">Years Of Experience</span>
                            <span class="s_website_form_mark">*</span>
                        </label>
                        <div class="col-sm">
                            <input id="recruitment9" type="text"
                                   class="form-control s_website_form_input"
                                   name="years_of_experience" required=""
                                   data-fill-with="text"/>
                        </div>
                    </div>
                </div>
                <div class="col-12 mb-0 py-2 s_website_form_field s_website_form_required"
                     data-type="date" data-name="Field">
                    <div class="row s_col_no_resize s_col_no_bgcolor">
                        <label class="col-4 col-sm-auto s_website_form_label" style="width: 200px" for="recruitment11">
                            <span class="s_website_form_label_content">Availability</span>
                            <span class="s_website_form_mark">*</span>
                        </label>
                        <div class="col-sm">
                            <input id="recruitment9" type="date"
                                   class="orm-control datetimepicker-input s_website_form_input"
                                   name="availability" required=""
                                   data-fill-with="date"/>
                        </div>
                    </div>
                </div>
