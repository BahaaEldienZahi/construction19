<odoo>
    <data>

        <record id="hr_kanban_view_applicant" model="ir.ui.view">
            <field name="name">inherit.hr.applicant.kanban</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
            <field name="arch" type="xml">
                <xpath expr="//kanban" position="replace">
                    <kanban records_draggable="0" default_group_by="stage_id" class="o_kanban_applicant"
                            quick_create_view="hr_recruitment.quick_create_applicant_form" sample="1">
                        <field name="stage_id"/>
                        <field name="color"/>
                        <field name="priority"/>
                        <field name="user_id"/>
                        <field name="user_email"/>
                        <field name="partner_name"/>
                        <field name="type_id"/>
                        <field name="partner_id"/>
                        <field name="job_id"/>
                        <field name="department_id"/>
                        <field name="attachment_number"/>
                        <field name="active"/>
                        <field name="activity_ids"/>
                        <field name="activity_state"/>
                        <field name="application_count"/>
                        <progressbar field="activity_state"
                                     colors="{&quot;planned&quot;: &quot;success&quot;, &quot;overdue&quot;: &quot;danger&quot;, &quot;today&quot;: &quot;warning&quot;}"/>
                        <templates>
                            <t t-name="kanban-box">
                                <div t-attf-class="{{!selection_mode ? 'oe_kanban_color_' + kanban_getcolor(record.color.raw_value) : ''}} oe_kanban_card oe_kanban_global_click oe_applicant_kanban oe_semantic_html_override">
                                    <span class="badge badge-pill badge-danger pull-right mr-4"
                                          invisible="active">Refused
                                    </span>

                                    <div class="oe_kanban_content">
                                        <div class="o_kanban_record_top">
                                            <div class="o_kanban_record_headings">
                                                <b class="o_kanban_record_title mt8"
                                                   t-if="record.partner_name.raw_value">
                                                    <field name="partner_name"/>
                                                    <br/>
                                                </b>
                                                <t t-else="1">
                                                    <i class="o_kanban_record_title">
                                                        <field name="name"/>
                                                    </i>
                                                    <br/>
                                                </t>
                                                <div class="o_kanban_record_subtitle"
                                                     invisible="context.get('search_default_job_id', False)">
                                                    <field name="job_id"/>
                                                </div>
                                            </div>
                                        </div>
                                        <field name="categ_ids" widget="many2many_tags"
                                               options="{'color_field': 'color'}"/>
                                        <t t-if="record.partner_mobile.raw_value">
                                            <i class="fa fa-mobile mr4" role="img" aria-label="Mobile" title="Mobile"/>
                                            <field name="partner_mobile" widget="phone"/>
                                            <br/>
                                        </t>
                                        <div class="o_kanban_record_bottom mt4">
                                            <div class="oe_kanban_bottom_left">
                                                <div class="float-left mr4" groups="base.group_user">
                                                    <field name="priority" widget="priority"/>
                                                </div>
                                                <div class="o_kanban_inline_block mr8">
                                                    <field name="activity_ids" widget="kanban_activity"/>
                                                </div>
                                            </div>
                                            <div class="oe_kanban_bottom_right">
                                                <div style="margin-right:10px">
                                                    <a name="action_applications_email" class="oe_stat_button"
                                                       icon="fa-pencil" type="object" context="{'active_test': False}"
                                                       invisible="application_count == 0">
                                                        <!--                                                       attrs="{'invisible': [('application_count', '=', 0)]}">-->
                                                        <field name="application_count"/>
                                                        App/s
                                                    </a>
                                                </div>


                                                <div style="margin-right:10px">
                                                    <field name="feedback_required2" invisible="1"/>
                                                    <field name="interview_details_required" invisible="1"/>
                                                    <a name="open_stages_applicant" type="object"
                                                       invisible="not feedback_required2 and not interview_details_required">
                                                        <!--                                                       attrs="{'invisible':  [('feedback_required2', '=', False),('interview_details_required','=',False)]}">-->
                                                        <span title="Feedback">
                                                            <i class="fa fa-envelope-o" aria-label="Feedback"/>
                                                        </span>
                                                    </a>
                                                </div>
                                                <a name="action_get_attachment_tree_view" type="object">
                                                    <span title="Documents">
                                                        <i class="fa fa-paperclip" role="img" aria-label="Documents"/>
                                                        <t t-esc="record.attachment_number.raw_value"/>
                                                    </span>
                                                </a>
                                                <div class="o_kanban_state_with_padding ml-1 mr-2">
                                                    <field name="kanban_state" widget="state_selection"/>
                                                    <field name="legend_normal" invisible="1"/>
                                                    <field name="legend_blocked" invisible="1"/>
                                                    <field name="legend_done" invisible="1"/>
                                                </div>
                                                <field name="user_id" widget="many2one_avatar_user"/>
                                            </div>

                                        </div>
                                    </div>
                                    <div class="oe_clear"/>
                                </div>
                            </t>
                        </templates>
                    </kanban>

                </xpath>
            </field>

        </record>


        <record id="hr_applicant_view_form_inherit2" model="ir.ui.view">
            <field name="name">inherit.hr.applicant.form</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="sheet//div[@name='button_box']" position="inside">
                    <button name="action_show_job_offers" class="oe_stat_button" icon="fa-book"
                            type="object" help="Job Offers">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="job_offers_count"/>
                            </span>
                            <span class="o_stat_text">Job Offers</span>
                        </div>
                    </button>

                    <button name="action_open_ticket" class="oe_stat_button" icon="fa-ticket"
                            type="object" help="open Ticket">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="ticket_count"/>
                            </span>
                            <span class="o_stat_text">Tickets</span>
                        </div>
                    </button>


                </xpath>
                <xpath expr="//group/group[4]" position="after">
                    <group string="Interview" name="interview">
                        <field name="interview_details_required" invisible="1"/>
                        <field name="meeting_type" required="interview_details_required" invisible="not interview_details_required"/>
                        <field name="interview_day" required="1" invisible="not interview_details_required"/>
                        <field name="start_time"  required="0" invisible="not interview_details_required"/>
                        <field name="end_time" required="0" invisible="not interview_details_required"/>
                        <field name="unavailable_room_ids" invisible="1" />
                        <field name="meeting_link" widget="url"
                               required="interview_details_required and meeting_type == 'online'" invisible="not interview_details_required"/>
                        <field name="meeting_room" required="meeting_type == 'offline'" invisible=" not interview_details_required"/>
                        <field name="meeting_note" string='Note' widget="url"
                               invisible="not interview_details_required"/>
                    </group>
                </xpath>
                <xpath expr="//button[@name='archive_applicant']" position="before">
                    <field name="hide_create_action" invisible="1"/>
                    <field name="is_hide_create_offer" invisible="1"/>
                    <field name="hide_generate_offer" invisible="1"/>
                    <button name="create_job_offer_from_applicant" string="Generate Job Offer" type="object"
                            invisible="hide_create_action == True" class="oe_highlight"
                            confirm="Job Offer is Successfully Created"/>

                    <field name="show_send_attachment_reminder" invisible="1"/>
                    <button name="send_attachment_reminder_manually" string="Send Working Documents" type="object"
                            invisible="not show_send_attachment_reminder"
                            groups="hr_recruitment.group_hr_recruitment_user" class="oe_highlight"/>
                </xpath>
                <xpath expr="//group[1]//group[3]//field[@name='company_id']" position="after">
                    <field name="job_offer_ids" widget="accrual_levels_one2many">
                        <tree create="0" delete="0" default_order="number desc" limit="3">
                            <field name="number"/>
                            <field name="offer_date"/>
                        </tree>
                    </field>
                </xpath>
                <xpath expr="//header/field[@name='stage_id']" position="attributes">
                    <attribute name="force_save">1</attribute>
                </xpath>
                <xpath expr="//field[@name='user_id']" position="attributes">
                    <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
                </xpath>
                <xpath expr="//field[@name='availability']" position="attributes">
                    <attribute name="required">0</attribute>
                    <attribute name="string">joining date</attribute>
                </xpath>
            </field>
        </record>

        <record id="hr_recruitment_stage_form" model="ir.ui.view">
            <field name="name">inherit.hr.recruitment.stage.form</field>
            <field name="model">hr.recruitment.stage</field>
            <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='job_ids']" position="after">
                    <field name="interview_details_required"/>
                    <field name="job_offer"/>
                    <field name="show_send_reminder"/>
                </xpath>
            </field>
        </record>

        <record model="ir.ui.view" id="nt_recruitment_update_tree_view_job">
            <field name="name">Applicants</field>
            <field name="model">hr.applicant</field>
            <field name="arch" type="xml">
                <tree string="Applicants" multi_edit="1" sample="1">
                    <field name="create_date" readonly="1" widget="date" optional="show"/>
                    <!--                    <field name="partner_name" readonly="1"/>-->
                    <field name="company_id" invisible="1"/>
                    <field name="name" readonly="1"/>
                    <field name="job_id"/>
                    <field name="categ_ids" widget="many2many_tags" options="{'color_field': 'color'}" optional="show"/>
                    <field name="source_id" readonly="1" optional="hide"/>
                    <field name="type_id" invisible="1"/>
                    <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                    <field name="meeting_type"/>
                    <field name="meeting_link" widget="url"/>
                    <field name="meeting_note"/>
                    <field name="attachment_number" invisible="1"/>
                    <field name="interview_date"/>
                    <field name="attachment_ids" widget="many2many_tags"/>
                    <button name="action_get_attachment_tree_view" class="oe_stat_button" icon="fa-book"
                            type="object" invisible="attachment_number == 0">
                        <!--                        attrs="{'invisible':  [('attachment_number', '=', 0)]}">-->
                        <field name="attachment_number" widget="statinfo" string="Documents"/>
                    </button>

                </tree>
            </field>
        </record>

        <record id="hr_applicant_view_tree_inherit" model="ir.ui.view">
            <field name="name">hr.applicant.tree.inherit</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="nt_recruitment_update.nt_recruitment_update_tree_view_job"/>
            <field name="arch" type="xml">
                <field name="create_date" position="attributes">
                    <attribute name="invisible">True</attribute>
                </field>
                <field name="categ_ids" position="attributes">
                    <attribute name="invisible">True</attribute>
                </field>
                <field name="name" position="before">
                    <field name="interview_date" position="move"/>
                </field>
            </field>
        </record>


        <record model="ir.actions.act_window" id="action_nt_recruitment_update">
            <field name="name">Scheduled Interviews</field>
            <field name="res_model">hr.applicant</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('nt_recruitment_update_tree_view_job')})
                          ]"/>
            <field name="domain">[('interview_date', '!=', False)]
            </field>

        </record>

        <record model="ir.actions.act_window" id="nt_recruitment_update_action_nt_recruitment_update">
            <field name="name">Scheduled Interviews</field>
            <field name="res_model">hr.applicant</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('nt_recruitment_update.nt_recruitment_update_tree_view_job')})
                          ]"/>
            <field name="domain">[('interview_date', '!=', False), ('interview_date', '>=', today)]
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_nt_recruitment_update_inherit">
            <field name="name">Outdated Scheduled Interviews</field>
            <field name="res_model">hr.applicant</field>
            <field name="view_mode">tree,form</field>
            <field name="view_ids"
                   eval="[(5, 0, 0),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('nt_recruitment_update.nt_recruitment_update_tree_view_job')})
                          ]"/>
            <field name="domain">[('interview_date', '!=', False)]
            </field>
        </record>
        <menuitem
                id="menu_nt_recruitment_update"
                action="action_nt_recruitment_update"
                parent="hr_recruitment.menu_hr_recruitment_root"
                groups="nt_recruitment_update.group_interviewer,hr_recruitment.group_hr_recruitment_manager"
        />

        <menuitem
                id="menu_nt_recruitment_update_inherit"
                action="nt_recruitment_update_action_nt_recruitment_update"
                parent="nt_recruitment_update.menu_nt_recruitment_update"
                groups="nt_recruitment_update.group_interviewer,hr_recruitment.group_hr_recruitment_manager"
        />

        <menuitem
                id="menu_nt_recruitment_update_inherit_out"
                action="action_nt_recruitment_update_inherit"
                parent="nt_recruitment_update.menu_nt_recruitment_update"
                groups="nt_recruitment_update.group_interviewer,hr_recruitment.group_hr_recruitment_manager"
        />

    </data>
</odoo>
