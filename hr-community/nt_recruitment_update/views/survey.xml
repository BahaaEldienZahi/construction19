<odoo>


        <record id="survey_form_view_inherit" model="ir.ui.view">
            <field name="name">survey form view inherit</field>
            <field name="model">survey.survey</field>
            <field name="inherit_id" ref="survey.survey_survey_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet" position="inside">
                    <group>
                        <group>
                            <field name="is_welcome_survey" string="On boarding survey"/>
                        </group>
                    </group>
                </xpath>
            </field>
        </record>

</odoo>
