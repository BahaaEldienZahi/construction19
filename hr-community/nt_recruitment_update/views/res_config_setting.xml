<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.recruitment</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="75"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <!--                <xpath expr="//div[hasclass('settings')]//div[@data-key='hr_recruitment']" position="inside">-->
                <xpath expr="//form" position="inside">
                    <h2>Acceptance Date</h2>
                    <div class="row mt16 o_settings_container" name="acceptance_date_setting_container">
                        <div class="col-12 col-lg-6 o_setting_box"
                             title="Acceptance Date">
                            <div class="o_setting_left_pane">
                                <field name="acceptance_mail"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="acceptance_mail"/>
                                <div class="text-muted">
                                    Send Mail Before Acceptance Date
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <record id="res_config_settings_view_form_employee" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.recruitment.employee</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="75"/>
            <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//block[@name='employee_rights_setting_container']" position="after">
                    <block title="Recruitment Employee Accounts" name="recruitment_employees_accounting">
                        <setting title="Recruitment Account Receivable">
                            <field name="recruitment_account_receivable_id"/>
                        </setting>
                        <setting title="Recruitment Account Payable">
                            <field name="recruitment_account_payable_id"/>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>

    </data>
</odoo>