                                            Accept offer
                                        </label>
                                    </div>

                                    <div class="form-check form-check-inline">
                                        <input class="form-check-input" type="radio" name="decision" id="reject_offer"
                                               value="reject"/>
                                        <label class="form-check-label" for="reject_offer">
                                            Reject offer
                                        </label>
                                    </div>
                                </div>

                                <div class="form-row justify-content-center mb-3">
                                    <div class="col-auto">
                                        <input class="form-control" type="date" name="join_date" id="join_date"
                                               hidden="hidden"/>
                                    </div>
                                </div>
                                <div class="form-row justify-content-center mb-3">
                                    <div class="col-auto">
                                        <input class="form-control" type="text" name="reject_reason" id="reject_reason"
                                               hidden="hidden" placeholder="reject reason .. "/>
                                    </div>
                                </div>

                                <div class="form-row justify-content-center">
                                    <div class="o_job_offer_portal_error alert alert-danger d-none" role="alert"
                                         style="margin-bottom: 10px; text-align: center;">
                                        <p class="p_job_offer_portal_error">There is something went wrong.</p>
                                    </div>
                                    <div class="col-auto">
                                        <button type="submit" class="btn btn-primary">Submit</button>
                                    </div>
                                </div>
                            </form>

                            <script type="text/javascript">
                                document.addEventListener('DOMContentLoaded', function () {

                                var acceptOffer = document.getElementById('accept_offer');
                                var rejectOffer = document.getElementById('reject_offer');
                                var joinDate = document.getElementById('join_date');
                                var reject_reason = document.getElementById('reject_reason');


                                acceptOffer.addEventListener('change', function () {
                                console.log('____________________acccept_________________________');
                                joinDate.removeAttribute('hidden');
                                reject_reason.setAttribute('hidden', 'hidden');
                                });

                                rejectOffer.addEventListener('change', function () {
                                console.log('________________reject_____________________________');
                                joinDate.setAttribute('hidden', 'hidden');
                                reject_reason.removeAttribute('hidden');
                                });


                                });

                            </script>
                        </div>
                    </t>
