<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="boarding_tree" model="ir.ui.view">
        <field name="name">On Boarding Tree</field>
        <field name="model">boarding.boarding</field>
        <field name="arch" type="xml">
            <tree string="">
                <field name="employee_id"/>
                <field name="department_id"/>
            </tree>
        </field>
    </record>

    <record id="boarding_form" model="ir.ui.view">
        <field name="name">On Boarding Form</field>
        <field name="model">boarding.boarding</field>
        <field name="arch" type="xml">
            <form string="">
                <header>
                    <button name="action_move" string="Move" type="object" class="oe_highlight"/>
                    <field name="stage_id" widget="statusbar" />
                </header>
                <sheet>
                    <h1 class="d-flex justify-content-between align-items-center">
                        <field name="name"/>
                    </h1>
                    <group>
                        <group>

                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="partner_mobile"/>
                        </group>
                        <group>
                            <field name="work_email"/>
                            <field name="responsible_id"/>
                            <field name="is_done"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>
    <record id="boarding_kanban" model="ir.ui.view">
        <field name="name">On Boarding kanban</field>
        <field name="model">boarding.boarding</field>
        <field name="arch" type="xml">
            <kanban records_draggable="False" default_group_by="stage_id" class="o_kanban_small_column" sample="1">
                <field name="id"/>
                <field name="stage_id"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="responsible_id"/>
                <progressbar field="activity_state"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>

                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click_edit mx-0 d-flex flex-row">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <b class="o_kanban_record_title mt8">
                                            <field name="employee_id"/>
                                            <br/>
                                            <br/>
                                        </b>
                                        <t>
                                            <i class="o_kanban_record_title">
                                                <field name="department_id"/>
                                            </i>
                                            <br/>
                                            <br/>
                                        </t>
                                        <div class="o_kanban_record_subtitle">
                                            <field name="responsible_id"/>
                                        </div>
                                        <div class="o_kanban_record_subtitle">
                                            <button name="action_move" string="Move" type="object" class="oe_highlight"/>
                                        </div>
                                    </div>
                                </div>

                                <t>
                                    <i class="fa fa-mobile mr4" role="img" aria-label="Mobile" title="Mobile"/>
                                    <field name="partner_mobile" widget="phone"/>
                                    <br/>
                                </t>

                            </div>
                            <div class="oe_clear"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="boarding_action" model="ir.actions.act_window">
        <field name="name">On Boarding</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">boarding.boarding</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('boarding_kanban')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('boarding_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('boarding_form')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No data yet!
            </p>
        </field>
    </record>
    <record id="hr_recruitment.menu_hr_recruitment_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(4,ref('nt_recruitment_update.on_boarding_group'))]"/>
    </record>

<!--    <menuitem name="ON/Off Boarding" id="boarding_menu" parent="hr_recruitment.menu_hr_recruitment_root" sequence="80" groups="nt_recruitment_update.on_boarding_group"/>-->

