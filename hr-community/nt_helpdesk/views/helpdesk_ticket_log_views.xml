<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="helpdesk_ticket_log_tree" model="ir.ui.view">
        <field name="name">helpdesk.area.tree</field>
        <field name="model">helpdesk.ticket.log</field>
        <field name="arch" type="xml">
            <tree create="0">
                <field name="ticket_name"/>
                <field name="stage_id"/>
<!--                <field name="department_id"/>-->
                <field name="team_id"/>
                <field name="priority" widget="priority"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="create_date"/>
                <field name="create_uid"/>
                <field name="change"/>

            </tree>
        </field>
    </record>
    <record id="helpdesk_ticket_log_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.log.search</field>
        <field name="model">helpdesk.ticket.log</field>
        <field name="arch" type="xml">
            <search string="">
                <field name="ticket_name"/>
<!--                <field name="department_id"/>-->
                <field name="team_id"/>
                <field name="employee_id"/>
                <field name="user_id"/>
                <group expand="0" string="Group By">
<!--                    <filter string="Department" name="department_group" domain="[]" context="{'group_by': 'department_id'}"/>-->
                    <filter string="Team" name="team" domain="[]" context="{'group_by': 'team_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="helpdesk_ticket_log_action" model="ir.actions.act_window">
        <field name="name">Helpdesk Ticket Log</field>
        <field name="res_model">helpdesk.ticket.log</field>
        <field name="view_mode">tree</field>
        <field name="context">{'group_by':'ticket_name'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Ticket Log
            </p>
        </field>
    </record>
    <menuitem id="helpdesk_ticket_log_action_menu"
              name="Ticket Log"
              action="helpdesk_ticket_log_action"
              parent="helpdesk_mgmt.helpdesk_ticket_reporting_menu"
              groups="nt_helpdesk.group_helpdesk_ticket_log"
              sequence="14"/>
</odoo>