<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_helpdesk_team_form" model="ir.ui.view">
        <field name="name">inherit.helpdesk.team.form</field>
        <field name="model">helpdesk.ticket.team</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_team_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='right']" position="inside">
                <field name="assigned_user_id" options="{'no_open': True, 'no_create': True}"/>
                <field name="department_ids" widget="many2many_tags"
                       options="{'no_open': True, 'no_create': True}"/>
                <field name="team_user_ids" widget="many2many_tags"
                       options="{'no_open': True, 'no_create': True}"/>
                <field name="assign_user_ids" widget="many2many_tags"
                       options="{'no_open': True, 'no_create': True}"/>
                <field name="close_user_id" options="{'no_open': True, 'no_create': True}"/>
                <field name="helpdesk_ticket_type_ids" widget="many2many_tags"/>
                <field name="area" string="Using Area"/>
                <field name="helpdesk_area_ids" invisible="not area" widget="many2many_tags"/>
                <field name="invisible_field_ids" widget="many2many_tags"
                       options='{"no_create": True,"no_quick_create": True, "no_create_edit": True}'/>
                <field name="required_project_team_id"/>
                <field name="required_stage_id" required="required_project_team_id == True"
                       invisible="not required_project_team_id"/>
                <field name="helpdesk_required_field_ids" required="required_project_team_id == True"
                       invisible="not required_project_team_id" widget="many2many_tags"
                       options='{"no_open": True, "no_create": True}'/>
                <field name="is_team_project"/>
                <field name="external"/>
                <field name="helpdesk_categ_ids" widget="many2many_tags"
                       options='{"no_create": True,"no_quick_create": True, "no_create_edit": True}'/>
                <field name="helpdesk_product_ids" widget="many2many_tags"
                       options='{"no_create": True,"no_quick_create": True, "no_create_edit": True}'/>
                <field name="required_field_ids" widget="many2many_tags"
                       options='{"no_open": True, "no_create": True}'/>
            </xpath>

        </field>
    </record>
</odoo>
