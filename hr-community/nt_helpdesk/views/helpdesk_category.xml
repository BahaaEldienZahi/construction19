<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_category_tree" model="ir.ui.view">
        <field name="name">helpdesk.category.tree</field>
        <field name="model">helpdesk.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="parent_id"/>
                <field name="company_id" optional="show"/>
                <field name="helpdesk_team_id"/>
                <field name="active" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="helpdesk_category_action" model="ir.actions.act_window">
        <field name="name">Helpdesk Category</field>
        <field name="res_model">helpdesk.category</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Category
            </p>
        </field>
    </record>
    <menuitem id="helpdesk_category_action_menu"
              name="Categories "
              action="helpdesk_category_action"
              parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu"
              sequence="3"/>
</odoo>
