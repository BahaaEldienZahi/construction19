<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="inherit_helpdesk_stage_form" model="ir.ui.view">
        <field name="name">inherit.helpdesk.stage.form</field>
        <field name="model">helpdesk.ticket.stage</field>
        <field name="inherit_id" ref="helpdesk_mgmt.view_helpdesk_ticket_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fold']" position="after">
                <field name="hide_stage_from_ids" widget="many2many_tags" options="{'color_field': 'id','no_open': True, 'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='fold']" position="before">
                <field name="is_close" />
                <field name="is_global" />
                <field name="is_reopen" />
                <field name="is_to_check" />
            </xpath>
        </field>
    </record>
</odoo>
