<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="helpdesk_area_tree" model="ir.ui.view">
        <field name="name">helpdesk.area.tree</field>
        <field name="model">helpdesk.area</field>
        <field name="arch" type="xml">
            <tree  editable="bottom">
                <field name="name"/>
                <field name="parent_id"  />
            </tree>
        </field>
    </record>

    <record id="helpdesk_area_action" model="ir.actions.act_window">
        <field name="name">Helpdesk Area</field>
        <field name="res_model">helpdesk.area</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Area
            </p>
        </field>
    </record>
    <menuitem id="helpdesk_area_action_menu"
              name="Areas"
              action="helpdesk_area_action"
              parent="helpdesk_mgmt.helpdesk_ticket_config_main_menu"
              sequence="4"/>

</odoo>