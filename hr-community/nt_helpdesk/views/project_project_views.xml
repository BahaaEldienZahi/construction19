        <record id="project_project_code_sequence" model="ir.sequence">
            <field name="name">Project code sequence</field>
            <field name="code">project.project</field>
            <field name="prefix">P/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="reset_neq_sequence_for_code" model="ir.actions.server">
            <field name="name">new code sequence</field>
            <field name="model_id" ref="nt_helpdesk.model_project_project"/>
            <field name="binding_model_id" ref="nt_helpdesk.model_project_project"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                if records:
                    for record in records:
                        action = record.reset_code_sequence_to_old_records()</field>
        </record>

        <record id="edit_project" model="ir.ui.view">
