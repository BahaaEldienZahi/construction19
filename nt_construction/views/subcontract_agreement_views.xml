<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_subcontract_agreement_form" model="ir.ui.view">
        <field name="name">subcontract.agreement.form</field>
        <field name="model">subcontract.agreement</field>
        <field name="arch" type="xml">
            <form string="Subcontract Agreement">
                <header>
                    <button name="action_submit_for_approval" string="Submit for Approval" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="nt_construction.group_construction_project_manager,project.group_project_manager"/>
                    <button name="action_approve_l1" string="Approve (Level 1)" type="object" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="nt_construction.group_construction_approver_l1,project.group_project_manager"/>
                    <button name="action_approve_l2" string="Final Approval (Level 2)" type="object" class="btn-primary"
                            invisible="state != 'approved_l1'"
                            groups="nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <button name="action_reject" string="Reject" type="object" class="btn-secondary"
                            invisible="state not in ('submitted', 'approved_l1')"
                            confirm="Reject this subcontract agreement? Write the reason in the Approval tab or the chatter."
                            groups="nt_construction.group_construction_approver_l1,project.group_project_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state not in ('rejected', 'cancelled')"
                            groups="nt_construction.group_construction_project_manager,project.group_project_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state in ('approved', 'cancelled')"
                            confirm="Cancel this subcontract agreement?"
                            groups="nt_construction.group_construction_project_manager,project.group_project_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved_l1,approved"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_project" type="object" class="oe_stat_button" icon="fa-building">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Project</span>
                            </div>
                        </button>
                        <button name="action_view_daily_reports" type="object" class="oe_stat_button" icon="fa-users"
                                invisible="not daily_report_count">
                            <field name="daily_report_count" widget="statinfo" string="Crew Reports"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="who">
                            <field name="project_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="partner_id" readonly="state != 'draft'" widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'supplier'}"/>
                        </group>
                        <group name="when_value">
                            <field name="date" readonly="state != 'draft'"/>
                            <label for="start_date" string="Contract Period"/>
                            <div class="o_row">
                                <field name="start_date" readonly="state != 'draft'" class="oe_inline"/>
                                <i class="fa fa-long-arrow-right mx-2 o_nt_period_arrow" title="to"/>
                                <field name="completion_date" readonly="state != 'draft'" class="oe_inline"/>
                            </div>
                            <field name="contract_value" readonly="state != 'draft'"/>
                            <field name="retention_percentage" readonly="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOQ Lines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="boq_line_id" options="{'no_create': True}"/>
                                    <field name="code" optional="show"/>
                                    <field name="name" optional="hide"/>
                                    <field name="uom_id" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer" name="totals">
                                <field name="total_value"/>
                            </group>
                        </page>
                        <page string="Scope of Work" name="scope">
                            <field name="scope_of_work" readonly="state != 'draft'" placeholder="Scope of work, exclusions, special conditions..."/>
                        </page>
                        <page string="Approval" name="approval" invisible="state == 'draft'">
                            <group>
                                <group>
                                    <field name="approver_l1_id" widget="many2one_avatar_user"/>
                                    <field name="approval_l1_date"/>
                                </group>
                                <group>
                                    <field name="approver_l2_id" widget="many2one_avatar_user"/>
                                    <field name="approval_l2_date"/>
                                </group>
                            </group>
                            <field name="rejection_reason" placeholder="Reason for rejection..." invisible="state != 'rejected'"/>
                        </page>
                        <page string="Other Info" name="other_info" groups="base.group_multi_company">
                            <group>
                                <group>
                                    <field name="company_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_subcontract_agreement_list" model="ir.ui.view">
        <field name="name">subcontract.agreement.list</field>
        <field name="model">subcontract.agreement</field>
        <field name="arch" type="xml">
            <list string="Subcontract Agreements" decoration-muted="state == 'cancelled'" multi_edit="0">
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <field name="start_date" optional="hide"/>
                <field name="completion_date" optional="show"/>
                <field name="total_value" sum="Total"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'approved'"
                       decoration-info="state in ('submitted', 'approved_l1')"
                       decoration-danger="state == 'rejected'"/>
            </list>
        </field>
    </record>

    <record id="view_subcontract_agreement_search" model="ir.ui.view">
        <field name="name">subcontract.agreement.search</field>
        <field name="model">subcontract.agreement</field>
        <field name="arch" type="xml">
            <search string="Search Subcontract Agreements">
                <field name="name"/>
                <field name="project_id"/>
                <field name="partner_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Waiting Approval" name="waiting" domain="[('state', 'in', ('submitted', 'approved_l1'))]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <separator/>
                <filter string="Not Cancelled" name="not_cancelled" domain="[('state', '!=', 'cancelled')]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Subcontractor" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_subcontract_agreement" model="ir.actions.act_window">
        <field name="name">Subcontracts</field>
        <field name="res_model">subcontract.agreement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_subcontract_agreement_search"/>
        <field name="context">{'search_default_not_cancelled': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a subcontract agreement</p>
            <p>Link subcontracted scope to BOQ items; approved agreements count as committed cost.</p>
        </field>
    </record>
</odoo>
