<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tablet-first document (site engineers): quantities tab first, at most 6 visible columns per
         line list, prices/amounts hidden from Site Engineers at field level (DECISIONS Q7). -->
    <record id="view_site_daily_report_form" model="ir.ui.view">
        <field name="name">site.daily.report.form</field>
        <field name="model">site.daily.report</field>
        <field name="arch" type="xml">
            <form string="Site Daily Report">
                <header>
                    <button name="action_confirm" string="Confirm Report" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="nt_construction.group_construction_project_manager,project.group_project_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state != 'confirmed'"
                            groups="nt_construction.group_construction_project_manager,project.group_project_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_project" type="object" class="oe_stat_button" icon="fa-building">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Project</span>
                            </div>
                        </button>
                        <button name="action_view_measurements" type="object" class="oe_stat_button" icon="fa-calculator"
                                invisible="not measurement_count">
                            <field name="measurement_count" widget="statinfo" string="Measurements"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="who">
                            <field name="project_id" readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="user_id" widget="many2one_avatar_user" readonly="1"/>
                            <field name="weather" readonly="state != 'draft'"/>
                        </group>
                        <group name="when_value">
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="total_manpower_count"/>
                            <field name="total_equipment_hours" widget="float_time"/>
                            <field name="total_amount_executed_today"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Quantities Executed" name="quantities">
                            <field name="progress_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="boq_line_id" options="{'no_create': True}"
                                           domain="[('project_id', '=', parent.project_id), ('is_group', '=', False)]"/>
                                    <field name="quantity_executed" string="Quantity"/>
                                    <field name="note" optional="show"/>
                                    <field name="period_name" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Manpower" name="manpower">
                            <field name="manpower_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="trade"/>
                                    <field name="headcount" sum="Total"/>
                                    <field name="hours" widget="float_time"/>
                                    <field name="is_subcontractor" optional="show"/>
                                    <field name="subcontract_agreement_id" optional="show" options="{'no_create': True}"/>
                                    <field name="note" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Equipment" name="equipment">
                            <field name="equipment_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="equipment_name"/>
                                    <field name="equipment_type"/>
                                    <field name="count"/>
                                    <field name="hours_worked" widget="float_time" sum="Total"/>
                                    <field name="hours_idle" widget="float_time" optional="show"/>
                                    <field name="idle_reason" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Site Notes" name="notes">
                            <field name="site_notes" nolabel="1" readonly="state != 'draft'"
                                   placeholder="Site issues, weather events, delays..."/>
                        </page>
                        <page string="Other Info" name="other_info" groups="base.group_multi_company">
                            <group>
                                <group>
                                    <field name="company_id"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_site_daily_report_list" model="ir.ui.view">
        <field name="name">site.daily.report.list</field>
        <field name="model">site.daily.report</field>
        <field name="arch" type="xml">
            <list string="Site Daily Reports" multi_edit="0">
                <field name="date"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="weather" optional="hide"/>
                <field name="total_manpower_count" string="Workers" sum="Total" optional="show"/>
                <field name="total_equipment_hours" string="Equipment Hours" widget="float_time" optional="hide"/>
                <field name="total_amount_executed_today" string="Executed Value" sum="Total Executed" optional="show"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge" decoration-success="state == 'confirmed'" decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <record id="view_site_daily_report_calendar" model="ir.ui.view">
        <field name="name">site.daily.report.calendar</field>
        <field name="model">site.daily.report</field>
        <field name="arch" type="xml">
            <calendar string="Site Daily Reports" date_start="date" mode="month" color="project_id"
                      quick_create="0" event_open_popup="0">
                <field name="project_id" filters="1"/>
                <field name="user_id"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_site_daily_report_search" model="ir.ui.view">
        <field name="name">site.daily.report.search</field>
        <field name="model">site.daily.report</field>
        <field name="arch" type="xml">
            <search string="Search Daily Reports">
                <field name="name"/>
                <field name="project_id"/>
                <field name="user_id"/>
                <filter string="My Reports" name="my_reports" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="To Confirm" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <separator/>
                <filter string="Last 7 Days" name="last_7_days"
                        domain="[('date', '&gt;=', (context_today() - relativedelta(days=6)).strftime('%Y-%m-%d'))]"/>
                <filter string="Date" name="filter_date" date="date"/>
                <group>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="Site Engineer" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Week" name="group_week" context="{'group_by': 'date:week'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_site_daily_report" model="ir.actions.act_window">
        <field name="name">Daily Reports</field>
        <field name="res_model">site.daily.report</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_site_daily_report_search"/>
        <field name="context">{'search_default_last_7_days': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Record today's site report</p>
            <p>Quantities executed, manpower and equipment on site, one report per project and day.</p>
        </field>
    </record>
</odoo>
