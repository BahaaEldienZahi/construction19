<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form standard (UX_SPEC §2): one btn-primary per state = the next step; ribbons for
         lost / cancelled; who/where left, when/value right; company under Other Info. -->
    <record id="view_tender_tender_form" model="ir.ui.view">
        <field name="name">tender.tender.form</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <form string="Tender">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"
                            invisible="state != 'draft'"
                            groups="nt_construction.group_construction_tender_engineer,nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <button name="action_under_evaluation" string="Move to Evaluation" type="object" class="btn-primary"
                            invisible="state != 'submitted'"
                            groups="nt_construction.group_construction_tender_engineer,nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <button name="action_set_won" string="Mark as Won" type="object" class="btn-primary"
                            invisible="state != 'under_evaluation'"
                            groups="nt_construction.group_construction_tender_engineer,nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <button name="action_set_won" string="Mark as Won" type="object" class="btn-secondary"
                            invisible="state != 'submitted'"
                            groups="nt_construction.group_construction_tender_engineer,nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <button name="action_create_project" string="Create Execution Project" type="object" class="btn-primary"
                            invisible="state != 'won' or project_id"
                            groups="nt_construction.group_construction_tender_engineer,nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <button name="action_set_lost" string="Mark as Lost" type="object" class="btn-secondary"
                            invisible="state not in ('submitted', 'under_evaluation')"
                            confirm="Mark this tender as lost? Enter the reason in the Lost / Cancel Reason tab."
                            groups="nt_construction.group_construction_tender_engineer,nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <button name="action_cancel" string="Cancel" type="object" class="btn-secondary"
                            invisible="state in ('cancelled', 'won', 'lost')"
                            confirm="Cancel this tender?"
                            groups="nt_construction.group_construction_tender_engineer,nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" class="btn-secondary"
                            invisible="state not in ('lost', 'cancelled')"
                            groups="nt_construction.group_construction_tender_engineer,nt_construction.group_construction_approver_l2,project.group_project_manager"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,under_evaluation,won"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_boq" type="object" class="oe_stat_button" icon="fa-list-ol">
                            <field name="boq_line_count" widget="statinfo" string="BOQ Lines"/>
                        </button>
                        <button name="action_view_project" type="object" class="oe_stat_button" icon="fa-building"
                                invisible="not project_id">
                            <field name="project_count" widget="statinfo" string="Project"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Lost" bg_color="text-bg-danger" invisible="state != 'lost'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-secondary" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group name="who">
                            <field name="client_id" readonly="state not in ('draft', 'submitted', 'under_evaluation')"/>
                            <field name="client_reference"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group name="when_value">
                            <field name="submission_deadline" readonly="state != 'draft'"/>
                            <field name="deadline_status" widget="badge" invisible="deadline_status == 'none'"
                                   decoration-success="deadline_status == 'ok'"
                                   decoration-warning="deadline_status == 'soon'"
                                   decoration-danger="deadline_status == 'overdue'"/>
                            <field name="opening_date"/>
                            <field name="date_won" invisible="not date_won"/>
                            <field name="estimated_value"/>
                            <field name="awarded_value" invisible="state not in ('under_evaluation', 'won', 'lost')"
                                   readonly="state in ('won', 'lost', 'cancelled')"/>
                            <field name="boq_total_contracted"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="BOQ Summary" name="boq">
                            <field name="boq_line_ids" readonly="1">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="total_contracted" string="Total" sum="Total"/>
                                </list>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Scope of work, conditions, client requirements..."/>
                        </page>
                        <page string="Lost / Cancel Reason" name="reason" invisible="state not in ('lost', 'cancelled', 'submitted', 'under_evaluation')">
                            <group>
                                <field name="lost_reason" invisible="state == 'cancelled'" placeholder="Why was the tender lost?"/>
                                <field name="cancel_reason" invisible="state == 'lost'" placeholder="Why was the tender cancelled?"/>
                            </group>
                        </page>
                        <page string="Other Info" name="other_info">
                            <group>
                                <group>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                    <field name="currency_id" groups="base.group_multi_currency"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Pipeline (UX_SPEC §2.3). Columns = state; drag and drop disabled (Q7): state changes go
         through the buttons. Progress bar = activities + column total (Odoo pipeline standard);
         the deadline is a badge on each card (DECISIONS UX-A3). -->
    <record id="view_tender_tender_kanban" model="ir.ui.view">
        <field name="name">tender.tender.kanban</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" records_draggable="0" quick_create="0" sample="1"
                    class="o_nt_tender_kanban">
                <field name="currency_id"/>
                <field name="deadline_status"/>
                <field name="days_to_deadline"/>
                <field name="project_id"/>
                <progressbar field="activity_state" sum_field="estimated_value"
                             colors='{"planned": "success", "today": "warning", "overdue": "danger"}'/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-baseline gap-2">
                            <field name="name" class="fw-bold text-truncate"/>
                            <field name="client_reference" class="text-muted small text-truncate"/>
                        </div>
                        <field name="client_id" class="text-truncate"/>
                        <field name="estimated_value" widget="monetary" class="fw-bold"/>
                        <div t-if="record.deadline_status.raw_value != 'none'" t-attf-class="small o_nt_deadline o_nt_deadline_{{ record.deadline_status.raw_value }}">
                            <span t-if="record.deadline_status.raw_value == 'overdue'" class="badge text-bg-danger" dir="auto">
                                <i class="fa fa-clock-o" title="Deadline"/> Deadline passed
                            </span>
                            <span t-elif="record.deadline_status.raw_value == 'soon'" class="badge text-bg-warning" dir="auto">
                                <i class="fa fa-clock-o" title="Deadline"/> <t t-out="record.days_to_deadline.raw_value"/> day(s) left
                            </span>
                            <span t-else="" class="badge text-bg-success" dir="auto">
                                <i class="fa fa-clock-o" title="Deadline"/> <t t-out="record.days_to_deadline.raw_value"/> day(s) left
                            </span>
                        </div>
                        <footer class="pt-1">
                            <div class="d-flex align-items-center gap-1">
                                <field name="activity_ids" widget="kanban_activity"/>
                                <span t-if="record.project_id.raw_value" class="badge text-bg-light">
                                    <i class="fa fa-building" title="Project"/> Project
                                </span>
                            </div>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_tender_tender_list" model="ir.ui.view">
        <field name="name">tender.tender.list</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <list string="Tenders" decoration-muted="state == 'cancelled'" multi_edit="0">
                <field name="name"/>
                <field name="client_id"/>
                <field name="client_reference" optional="hide"/>
                <field name="submission_deadline"/>
                <field name="deadline_status" widget="badge" optional="show"
                       decoration-success="deadline_status == 'ok'"
                       decoration-warning="deadline_status == 'soon'"
                       decoration-danger="deadline_status == 'overdue'"/>
                <field name="estimated_value" sum="Total Estimated"/>
                <field name="awarded_value" sum="Total Awarded" optional="hide"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'won'"
                       decoration-danger="state == 'lost'"
                       decoration-info="state in ('submitted', 'under_evaluation')"/>
            </list>
        </field>
    </record>

    <record id="view_tender_tender_search" model="ir.ui.view">
        <field name="name">tender.tender.search</field>
        <field name="model">tender.tender</field>
        <field name="arch" type="xml">
            <search string="Search Tenders">
                <field name="name"/>
                <field name="client_id"/>
                <field name="client_reference"/>
                <field name="user_id"/>
                <filter string="My Tenders" name="my_tenders" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter string="Open" name="open" domain="[('state', 'not in', ('lost', 'cancelled'))]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', 'in', ('draft', 'submitted', 'under_evaluation'))]"/>
                <filter string="Won" name="won" domain="[('state', '=', 'won')]"/>
                <filter string="Lost" name="lost" domain="[('state', '=', 'lost')]"/>
                <separator/>
                <filter string="Deadline This Week" name="deadline_week"
                        domain="[('state', '=', 'draft'),
                                 ('submission_deadline', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0, 0))),
                                 ('submission_deadline', '&lt;', datetime.datetime.combine(context_today() + relativedelta(days=7), datetime.time(0, 0)))]"/>
                <filter string="Submission Deadline" name="filter_deadline" date="submission_deadline"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Client" name="group_client" context="{'group_by': 'client_id'}"/>
                    <filter string="Responsible" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Deadline" name="group_deadline" context="{'group_by': 'submission_deadline:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_tender_tender" model="ir.actions.act_window">
        <field name="name">Tenders</field>
        <field name="res_model">tender.tender</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="search_view_id" ref="view_tender_tender_search"/>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first tender</p>
            <p>Track each tender from preparation to award, with its bill of quantities.</p>
        </field>
    </record>
</odoo>
