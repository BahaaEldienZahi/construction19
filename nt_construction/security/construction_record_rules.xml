<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Multi-company: global rules (no group), every construction model. Role / own-project
         rules are added on top of these in step 2 once the role matrix is confirmed. -->
    <record id="rule_tender_tender_company" model="ir.rule">
        <field name="name">Tender: multi-company</field>
        <field name="model_id" ref="model_tender_tender"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_boq_line_company" model="ir.rule">
        <field name="name">BOQ Line: multi-company</field>
        <field name="model_id" ref="model_boq_line"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_boq_line_progress_company" model="ir.rule">
        <field name="name">BOQ Progress Entry: multi-company</field>
