    <!-- ===== Role rules (DECISIONS Q2/Q3, S6). Group rules are OR-ed: a user holding an
         own-project role and a company-wide role (e.g. QS + Approver) sees the whole company. ===== -->

    <record id="rule_project_project_own_project" model="ir.rule">
        <field name="name">Project Project: own projects (site engineer / QS / PM)</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('construction_member_ids', 'in', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('group_construction_site_engineer')), Command.link(ref('group_construction_quantity_surveyor')), Command.link(ref('group_construction_project_manager'))]"/>
    </record>

