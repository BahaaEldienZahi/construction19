<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_construction" model="ir.module.category">
        <field name="name">Construction</field>
        <field name="sequence">45</field>
    </record>

    <!-- Technical group: may see prices and amounts. Implied by every role except Site Engineer
         (DECISIONS Q7). Fields use groups="...see_amounts,project.group_project_manager". -->
    <record id="group_construction_see_amounts" model="res.groups">
        <field name="name">Construction: See Prices and Amounts</field>
    </record>

    <!-- One privilege per role: roles can be combined on the same user. -->
    <record id="privilege_tender_engineer" model="res.groups.privilege">
        <field name="name">Tender Engineer</field>
        <field name="sequence">10</field>
        <field name="category_id" ref="module_category_construction"/>
    </record>
    <record id="group_construction_tender_engineer" model="res.groups">
        <field name="name">Tender Engineer</field>
        <field name="privilege_id" ref="privilege_tender_engineer"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('project.group_project_user')), Command.link(ref('group_construction_see_amounts'))]"/>
        <field name="comment">Prepares tenders and their BOQ; marks tenders won or lost; creates the execution project.</field>
    </record>

    <record id="privilege_site_engineer" model="res.groups.privilege">
        <field name="name">Site Engineer</field>
        <field name="sequence">20</field>
        <field name="category_id" ref="module_category_construction"/>
    </record>
    <record id="group_construction_site_engineer" model="res.groups">
        <field name="name">Site Engineer</field>
        <field name="privilege_id" ref="privilege_site_engineer"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('project.group_project_user'))]"/>
        <field name="comment">Daily reports and measurements on his projects. Sees quantities, not prices or amounts.</field>
    </record>

    <record id="privilege_quantity_surveyor" model="res.groups.privilege">
        <field name="name">Quantity Surveyor</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_construction"/>
    </record>
    <record id="group_construction_quantity_surveyor" model="res.groups">
        <field name="name">Quantity Surveyor</field>
        <field name="privilege_id" ref="privilege_quantity_surveyor"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('project.group_project_user')), Command.link(ref('group_construction_see_amounts'))]"/>
        <field name="comment">BOQ, measurements, variation orders and client certificates on his projects.</field>
    </record>

    <record id="privilege_project_manager" model="res.groups.privilege">
        <field name="name">Construction Project Manager</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="module_category_construction"/>
    </record>
    <record id="group_construction_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="privilege_id" ref="privilege_project_manager"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('project.group_project_user')), Command.link(ref('group_construction_see_amounts'))]"/>
        <field name="comment">Runs his own projects: confirms daily reports, variation orders, subcontracts, handover.</field>
    </record>

    <record id="privilege_accountant" model="res.groups.privilege">
        <field name="name">Construction Accountant</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_construction"/>
    </record>
    <record id="group_construction_accountant" model="res.groups">
        <field name="name">Accountant</field>
        <field name="privilege_id" ref="privilege_accountant"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('project.group_project_user')), Command.link(ref('account.group_account_invoice')), Command.link(ref('group_construction_see_amounts'))]"/>
        <field name="comment">Invoices approved certificates and records retention releases, all projects of the company.</field>
    </record>

    <record id="privilege_approval" model="res.groups.privilege">
        <field name="name">Construction Approval</field>
        <field name="sequence">60</field>
        <field name="category_id" ref="module_category_construction"/>
    </record>
    <record id="group_construction_approver_l1" model="res.groups">
        <field name="name">Approver - Level 1</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="privilege_approval"/>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user')), Command.link(ref('project.group_project_user')), Command.link(ref('group_construction_see_amounts'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
    <record id="group_construction_approver_l2" model="res.groups">
        <field name="name">Approver - Level 2 / Management</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="privilege_approval"/>
        <field name="implied_ids" eval="[Command.link(ref('group_construction_approver_l1'))]"/>
        <field name="user_ids" eval="[Command.link(ref('base.user_admin'))]"/>
    </record>
</odoo>
