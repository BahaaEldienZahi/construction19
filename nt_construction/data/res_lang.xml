<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Arabic (Egypt): Arabic text (translations fall back to ar.po) with Western digits (0-9).
         Odoo's web client forces Arabic-Indic digits only for ar_001 / ar_SA / ar_SY; every other
         locale, ar_EG included, gets "latn" (web/static/src/core/l10n/localization_service.js).
         Server-side formatting (PDF amounts and dates) uses Latin digits for all languages.
         PROVISIONAL until the client confirms (DECISIONS S9). Inactive by default: activate it in
         Settings > Languages (this loads the Arabic translations) and set it on the users. -->
    <record id="lang_ar_eg" model="res.lang" forcecreate="True">
        <field name="name">Arabic (Egypt) / العربية (مصر)</field>
        <field name="code">ar_EG</field>
        <field name="iso_code">ar_EG</field>
        <field name="url_code">ar_EG</field>
        <field name="direction">rtl</field>
        <field name="date_format">%d/%m/%Y</field>
        <field name="time_format">%I:%M:%S %p</field>
        <field name="week_start">6</field>
        <field name="grouping">[3,0]</field>
        <field name="decimal_point">.</field>
        <field name="thousands_sep">,</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
